# Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Production PostgreSQL / RDS
DB_HOST=<RDS_ENDPOINT>
DB_PORT=5432
DB_NAME=<RDS_DATABASE_NAME>
DB_USER=<RDS_USERNAME>
DB_PASSWORD=<RDS_PASSWORD>

# JWT
JWT_SECRET=<PRODUCTION_JWT_SECRET>
JWT_EXPIRATION_MS=3600000

# AI Provider
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_PROVIDER_API_KEY=<PRODUCTION_AI_API_KEY>
AI_MODEL=<PRODUCTION_AI_MODEL>

# Frontend
BACKEND_BASE_URL=<EC2_OR_DOMAIN_URL>
